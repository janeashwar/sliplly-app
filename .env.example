# ============================================
# Sliplly Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# App Environment (development | staging | production)
APP_ENV=development

# API Configuration
API_BASE_URL=http://10.0.2.2:8080/api
# API_BASE_URL=https://staging-api.sliplly.com/api
# API_BASE_URL=https://api.sliplly.com/api

# EAS / Expo
EAS_PROJECT_ID=your-project-id

# iOS
IOS_BUILD_NUMBER=1

# Android
ANDROID_VERSION_CODE=1
GOOGLE_SERVICES_JSON=./google-services.json

# OTA Updates (production only)
EXPO_UPDATES_URL=https://u.expo.dev/your-project-id

# Optional: Analytics
# ANALYTICS_KEY=your-analytics-key

# Optional: Sentry / Crash Reporting
# SENTRY_DSN=https://your-sentry-dsn

# Optional: Stripe (payment processing)
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Optional: Google Maps
# GOOGLE_MAPS_API_KEY=your-google-maps-key
